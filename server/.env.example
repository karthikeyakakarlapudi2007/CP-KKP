# See ../.env.example for the full reference.

# PostgreSQL connection string (Render: the database's Internal Database URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kodikura?schema=public"
PORT=4000
# Allowed browser origins, comma-separated; `*` matches one DNS label (Vercel previews)
CORS_ORIGIN="http://localhost:3000"
# Shared staff key for /admin and /kds. Empty = open (local development only)
STAFF_API_KEY=""
# Restaurant timezone offset in minutes from UTC, used for "today" analytics (IST = 330)
TZ_OFFSET_MINUTES=330
