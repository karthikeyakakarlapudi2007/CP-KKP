# PostgreSQL connection string (Render Postgres "Internal Database URL" in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kodikura?schema=public"
PORT=4000
# Comma-separated list of allowed browser origins (your Vercel domain)
CORS_ORIGIN="http://localhost:3000"
# Optional shared staff key. When set, /admin and /kds (and all staff API calls) require it.
STAFF_API_KEY=""
# Restaurant timezone offset in minutes from UTC, used for "today" analytics (IST = 330)
TZ_OFFSET_MINUTES=330
