# ─────────────────────────────────────────────────────────────────────────────
# Kodikura Pappucharu — environment reference
# Copy the relevant block into server/.env (Render) and web/.env.local (Vercel).
# ─────────────────────────────────────────────────────────────────────────────

# ===== server/.env — Express + Socket.IO on Render =====

# PostgreSQL. On Render use the database's "Internal Database URL".
# Under rush-hour load you can cap Prisma's pool, e.g. append &connection_limit=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kodikura?schema=public"

# Port to listen on (Render injects PORT automatically)
PORT=4000

# Browser origins allowed for REST + WebSockets, comma-separated.
# `*` matches a single DNS label, handy for Vercel preview deployments.
CORS_ORIGIN="http://localhost:3000,https://kodikura.vercel.app,https://kodikura-*.vercel.app"

# Shared key for /admin and /kds. Empty = no protection (local development only!)
STAFF_API_KEY=""

# Restaurant timezone offset from UTC in minutes, for "today" analytics (IST = 330)
TZ_OFFSET_MINUTES=330


# ===== web/.env.local — Next.js on Vercel =====

# Public URL of the Render service (REST API)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Socket.IO server URL. Leave empty to use NEXT_PUBLIC_API_URL (same Render service)
NEXT_PUBLIC_SOCKET_URL=""

# Public URL of this web app, encoded into the table QR codes (defaults to the browser origin)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# GST added on the bill, split equally into CGST + SGST (5 → 2.5% + 2.5%).
# Menu prices are treated as pre-tax. Set 0 if your menu prices already include GST.
NEXT_PUBLIC_GST_RATE=5
