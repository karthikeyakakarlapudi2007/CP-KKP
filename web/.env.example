# See ../.env.example for the full reference.

# Public URL of the Express API on Render
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Socket.IO URL — leave empty to reuse NEXT_PUBLIC_API_URL
NEXT_PUBLIC_SOCKET_URL=""
# Public URL of this web app, used to encode table QR codes (defaults to the current origin)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# GST % added to bills (CGST + SGST split equally). 0 if menu prices include tax.
NEXT_PUBLIC_GST_RATE=5
